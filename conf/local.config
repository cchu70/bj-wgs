/*
========================================================================================
    Local execution profile for BJ-WGS
========================================================================================
    Uses a locally installed Sentieon package instead of a container-embedded one.
    The Sentieon installation is bind-mounted into each process container at runtime.
    Set params.sentieon_license to your license file path before running.
----------------------------------------------------------------------------------------
    Usage:
      nextflow run main.nf -profile local \
        --sentieon_install_dir /mnt/thechenlab/ClaudiaC/packages/sentieon-genomics-202503.02 \
        --sentieon_license /path/to/sentieon.lic \
        --publish_dir /local/output/path \
        ...
----------------------------------------------------------------------------------------
*/

params {
    // Path to the local Sentieon installation directory
    sentieon_install_dir = "/mnt/thechenlab/ClaudiaC/packages/sentieon-genomics-202503.02"

    // Path to your Sentieon license file.
    // Provide via --sentieon_license /path/to/sentieon.lic  OR set SENTIEON_LICENSE in the environment.
    // For a license server use host:port format.
    sentieon_license     = ""

    // Container image to use for Sentieon processes.
    // Build it with: docker build -t sentieon-base:local -f Dockerfile .
    sentieon_local_container = "sentieon-base:local"

    // Reduce resource ceilings for local execution
    max_memory = 128.GB
    max_cpus   = 32
    max_time   = 72.h
}

process {
    // Mount the local Sentieon installation into every Sentieon process container
    // and expose the required environment variables.
    withName: 'SENTIEON_ALIGNMENT|SENTIEON_ALGORITHM|SENTIEON_DNASCOPE|SENTIEON_HAPLOTYPER|SENTIEON_DRIVER_METRICS|SENTIEON_DRIVER_COVERAGEMETRICS|SENTIEON_BWA_MEM' {
        container = params.sentieon_local_container
        containerOptions = {
            def licMount = ""
            def licEnv   = ""
            if (params.sentieon_license) {
                // File-based license: mount the file into the container at the same path
                licMount = "-v ${params.sentieon_license}:${params.sentieon_license}"
                licEnv   = "--env SENTIEON_LICENSE_SERVER=${params.sentieon_license}"
            } else {
                // Fall back to SENTIEON_LICENSE set in the host environment (e.g. host:port server)
                licEnv   = "--env SENTIEON_LICENSE_SERVER=\${SENTIEON_LICENSE:-}"
            }
            "--env LOCAL=true " +
            "${licEnv} " +
            "--env SENTIEON_BIN=/opt/sentieon_local/bin " +
            "-v ${params.sentieon_install_dir}:/opt/sentieon_local:ro " +
            "${licMount}"
        }
        cpus   = { Math.min(params.max_cpus as int,   16)  }
        memory = { Math.min(params.max_memory.toGiga() as long, 64) + ".GB" }
        time   = 48.h
        queue  = null
    }
}
