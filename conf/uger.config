/*
========================================================================================
    UGER (SGE) profile for BJ-WGS
========================================================================================
    Runs the pipeline on the Broad Institute UGER cluster.
    Each Nextflow task is submitted as an individual SGE job.
    Singularity is used in place of Docker.
    Sentieon is run from a local installation bind-mounted into each container.
----------------------------------------------------------------------------------------
    Usage:
      nextflow run main.nf -profile uger \
        --sentieon_install_dir /mnt/thechenlab/ClaudiaC/packages/sentieon-genomics-202503.02 \
        --sentieon_license /path/to/sentieon.lic \
        --publish_dir /path/to/output \
        ...
----------------------------------------------------------------------------------------
    Queue mapping (adjust to match your UGER allocation):
      short  — small, fast tasks   (≤ 3 GB memory, ≤ 2 CPUs)
      long   — large / slow tasks  (≤ 60 GB memory)
      long   — intense tasks       (≥ 64 CPUs / ≥ 123 GB memory; use hugemem if available)
----------------------------------------------------------------------------------------
*/

singularity {
    enabled    = true
    autoMounts = true
}

docker {
    enabled = false
}

aws {
    client {
        anonymous = true
    }
}

params {
    sentieon_install_dir     = "/mnt/thechenlab/ClaudiaC/packages/sentieon-genomics-202503.02"
    sentieon_local_container = "sentieon-base:local"
    max_memory               = 128.GB
    max_cpus                 = 64
    max_time                 = 72.h
}

process {
    executor = 'sge'
    queue    = 'broad'    // fallback for any process not listed below

    // Override the default Docker-style containerOptions from environment.config.
    // Singularity does not support -v; bind mounts use --bind (-B).
    // The sentieon_eval.lic reference is also removed — license is handled below.
    containerOptions = '--env LOCAL=true'

    // ── Sentieon processes: bind-mount local install + expose license ────────
    withName: 'SENTIEON_ALIGNMENT|SENTIEON_ALGORITHM|SENTIEON_DNASCOPE|SENTIEON_HAPLOTYPER|SENTIEON_DRIVER_METRICS|SENTIEON_DRIVER_COVERAGEMETRICS|SENTIEON_BWA_MEM|SENTIEON_DRIVER_LOCUSCOLLECTOR|SENTIEON_DRIVER_DEDUP|SENTIEON_DRIVER_BQSR|SENTIEON_DRIVER_RNA_SPLIT_READS_JUNCTIONS|SENTIEON_DRIVER_RNA_HAPLOTYPER_DNASCOPE|SENTIEON_DRIVER_TNSCOPE|SENTIEON_DRIVER_TNSCOPE_PANEL_OF_NORMAL|SENTIEON_DRIVER_TNSCOPE_TUMOR_PANEL_OF_NORMAL|SENTIEON_DRIVER_TNSEQ|SENTIEON_CNVSCOPE' {
        container        = params.sentieon_local_container
        containerOptions = {
            def licMount = ""
            def licEnv   = ""
            if (params.sentieon_license) {
                licMount = "--bind ${params.sentieon_license}:${params.sentieon_license}"
                licEnv   = "--env SENTIEON_LICENSE_SERVER=${params.sentieon_license}"
            } else {
                licEnv   = "--env SENTIEON_LICENSE_SERVER=\${SENTIEON_LICENSE:-}"
            }
            "--env LOCAL=true " +
            "${licEnv} " +
            "--env SENTIEON_BIN=/opt/sentieon_local/bin " +
            "--bind ${params.sentieon_install_dir}:/opt/sentieon_local:ro " +
            "${licMount}"
        }
    }

    // ── short queue: small / lightweight tasks ───────────────────────────────
    withName: 'PUBLISH_INPUT_DATASET|COMBINE_READ_COUNTS|REPORT_VERSIONS|SEQTK_SAMPLE|CUSTOM_FASTQ_MERGE|CUSTOM_DATA_PROCESSING|CNVSCOPE_REPORT|BAM_TO_BED|GINKGO_BINUNSORT|GINKGO_SEGMENTATION_R|GINKGO_CNV_CALLER|GINKO_RDS_TO_FLAT|GINKO_PARSE_OUTPUTS|PARSE_RDS_CNV_METRICS|BAM_LORENZ_COVERAGE|QUALIMAP_BAMQC|PRESEQ_BAM2MR|PRESEQ_GC_EXTRAP|CUSTOM_CALCULATE_MAPD|PREPROCESS_VCF|BCFTOOLS_QUERY_L|ANNOT_VCF_WITH_VCFEVAL|CONCAT_VCFEVAL_RESULTS|DETERMINE_EXPECTED_NEGATIVES|DETERMINE_TOTAL_NEGATIVES|CREATE_VCFEVAL_OVERALL_METRICS|EXTRACT_HET_SITES|SLICE_HET_INTERVALS|SUMMARIZE_ADO_INTERVALS|CONCAT_SUMMARY_ADO_INTERVALS|BCFTOOLS_FILTER|BGZIP_TABIX_FILTERD_VCF|BGZIP_TABIX|BCFTOOLS_MERGE|BGZIP_TABIX_MULTISAMPLE_VCF|SPLIT_VCF_BY_SAMPLES|TMBler|CUSTOM_COMBINE_METRICS|BAMSURGEON_ADDSNV|SIGPROFILERGENERATEMATRIX_MATRIX_GENERATOR|CUSTOM_MUTATIONCATALOG_MERGER|SIGPROFILE_HEATMAP|CUSTOM_FASTQ_MERGE_DATASETS|GENERATE_PANEL_OF_NORMAL|VARIANT_ANNOTATION_VEP|SPLIT_VCF_BY_CHR|CUSTOM_SPLIT_BAM_CHR|CUSTOM_SPLIT_QUERY_TABLE_CHR|CUSTOM_BAM_PILEUP_FILTER|CUSTOM_RSCRIPT_SOMATICSNP_FILTER_1_CELL_LEVEL_CREATE_TABLE|CUSTOM_RSCRIPT_SOMATICSNP_FILTER_2_CELL_LEVEL_CONCAT_FILTER_TABLE|CUSTOM_GET_LIST_POS_GROUP|CUSTOM_BAM_GROUP_PILEUP|CREATE_TAB_NVNR|CUSTOM_RSCRIPT_SOMATICSNP_FILTER_3_GROUPLEVEL_PROCESS_PILEUP_SAMPLE|SUBSET_VCF_VARIANTS|CREATE_TXIMPORT_SALMON_TX_GENE|MERGE_TXIMPORT_SALMON_TX_GENE|CREATE_MATRIX_SALMON_TX_GENE|HTSEQ_COUNTS|CREATE_HTSEQ_SUMMARY|MERGE_HTSEQ_SUMMARY|CREATE_HTSEQ_MATRIX|PLOTTER_PCAHEATMAP_HTSEQ_SUMMARY|CREATE_QC_REPORT|GENE_BODY_COVERAGE_RNA|GENE_BODY_COVERAGE_RNA_PLOT|CREATE_MASTER_STATS|CUSTOM_AWK_DEMUX_CBC_FASTQ|CALC_DYNAMICRANGE|SENTIEON_DRIVER_BQSR|SENTIEON_DRIVER_RNA_SPLIT_READS_JUNCTIONS|SENTIEON_DRIVER_RNA_HAPLOTYPER_DNASCOPE|SET_PSEUDO_BULK|COUNT_READS|CUSTOM_RSCRIPT_SOMATICSNP_FILTER_1_SAMPLELEVEL_PROCESS_PILEUP_SAMPLE_CIGAR' {
        queue = 'short'
    }

    // ── long queue: large / slow tasks ───────────────────────────────────────
    withName: 'COUNT_READS_FASTQ|FASTP|CUTADAPT|CUSTOM_REPORT|MULTIQC|MULTIQC_FOR_PARABRICKS|SENTIEON_DRIVER_DEDUP|SENTIEON_DRIVER_COVERAGEMETRICS|HAPPY|BOWTIE2_BUILD|BOWTIE2_ALIGN|VCFEVAL|IDENTIFY_GERMLINE_HETS|CREATE_ADO_TABLE|PICARD_COLLECTHSMETRICS|PICARD_COLLECTWGSMETRICS|BCFTOOLS_VIEW|SNPEFF_ANNOTATION|MERGE_VCFS|VARIANTQC|GATK_VARIANTSTOTABLE|CUSTOM_BAM_CONCATENATE_FILES|CUSTOM_BAM_SUBSAMPLE|PICARD_ADDORREPLACEREADGROUPS|BCFTOOLS_ISEC|SNPSIFT_ANNOTATION|SNPSIFT_DBNSFP|KRAKEN2|FASTQC|SENTIEON_BWA_MEM|CUSTOM_EXPANDED_FIELDS|SEQUOIA_BINOM_BETABINOM_TAB_NV_NR|CUSTOM_RSCRIPT_SOMATICSNP_FILTER_4_CREATE_TABNR_TABNV|CUSTOM_CREATE_GROUP_LEVEL_TAB_DFS|CUSTOM_SOMATIC_SNPINDEL_FILTERRAWTABLES|POSTPROCESS_SEQUOIA_DRAWVAFHEAT_TREE|SALMONQUANT|STARALIGN|QUALIMAP_BAMRNA|STARGETPRIM|CELL_TYPING|ALEVIN_NOQUANT_DUMPFQ|PETASUITE_DECOMPRESS|Manta|ExpansionHunter' {
        queue = 'long'
    }

    // ── long queue: intense / high-memory tasks ───────────────────────────────
    // NOTE: if your UGER has a hugemem queue, replace 'long' with 'hugemem' here
    withName: 'SENTIEON_ALIGNMENT|SENTIEON_ALGORITHM|SENTIEON_DNASCOPE|SENTIEON_HAPLOTYPER|SENTIEON_DRIVER_METRICS|SENTIEON_DRIVER_TNSCOPE|SENTIEON_DRIVER_TNSCOPE_PANEL_OF_NORMAL|SENTIEON_DRIVER_TNSCOPE_TUMOR_PANEL_OF_NORMAL|SENTIEON_DRIVER_TNSEQ|SENTIEON_CNVSCOPE|DEEPVARIANT_MAKE_EXAMPLES|DEEPVARIANT_POSTPROCESS|GOOGLE_DEEPVARIANT_CPU|MERGE_PROCESSED_VCF|CONCAT_FILTER_BINOM_BETABINOM_TAB_NV_NR|SEQUOIA|SAMTOOLS_CRAMTOBAM|ULTRAPLEX|PARABRICKS_HAPLOTYPER_GERMLINE|PARABRICKS_DEEPVARIANT_GERMLINE|PARABRICKS_DEEPVARIANT|PARABRICKS_BAMMETRICS|PARABRICKS_COLLECTMULTIPLEMETRICS|PARABRICKS_FQ2BAM|GOOGLE_DEEPVARIANT_FASTPIPELINE_GPU|GOOGLE_DEEPVARIANT_GPU|DEEPVARIANT_CALL_VARIANTS' {
        queue = 'long'
    }
}
