/*
========================================================================================
    UGER (SGE) profile for BJ-WGS
========================================================================================
    Runs the pipeline on the Broad Institute UGER cluster.
    Each Nextflow task is submitted as an individual SGE job.
    Singularity is used in place of Docker.
    Sentieon is run from a local installation bind-mounted into each container.
----------------------------------------------------------------------------------------
    Usage:
      nextflow run main.nf -profile uger \
        --sentieon_install_dir /mnt/thechenlab/ClaudiaC/packages/sentieon-genomics-202503.02 \
        --sentieon_license /path/to/sentieon.lic \
        --publish_dir /path/to/output \
        ...
----------------------------------------------------------------------------------------
    Queue: all jobs submitted to the 'broad' queue (only queue available on this cluster)
----------------------------------------------------------------------------------------
*/

singularity {
    enabled    = true
    autoMounts = true
}

docker {
    enabled = false
}

aws {
    client {
        anonymous = true
    }
}

params {
    sentieon_install_dir     = "/mnt/thechenlab/ClaudiaC/packages/sentieon-genomics-202503.02"
    sentieon_local_container = "sentieon-base:local"
    max_memory               = 128.GB
    max_cpus                 = 64
    max_time                 = 72.h
}

process {
    executor = 'sge'
    queue    = 'broad'    // fallback for any process not listed below

    // Override the default Docker-style containerOptions from environment.config.
    // Singularity does not support -v; bind mounts use --bind (-B).
    // The sentieon_eval.lic reference is also removed — license is handled below.
    containerOptions = '--env LOCAL=true'

    // ── Sentieon processes: bind-mount local install + expose license ────────
    withName: 'SENTIEON_ALIGNMENT|SENTIEON_ALGORITHM|SENTIEON_DNASCOPE|SENTIEON_HAPLOTYPER|SENTIEON_DRIVER_METRICS|SENTIEON_DRIVER_COVERAGEMETRICS|SENTIEON_BWA_MEM|SENTIEON_DRIVER_LOCUSCOLLECTOR|SENTIEON_DRIVER_DEDUP|SENTIEON_DRIVER_BQSR|SENTIEON_DRIVER_RNA_SPLIT_READS_JUNCTIONS|SENTIEON_DRIVER_RNA_HAPLOTYPER_DNASCOPE|SENTIEON_DRIVER_TNSCOPE|SENTIEON_DRIVER_TNSCOPE_PANEL_OF_NORMAL|SENTIEON_DRIVER_TNSCOPE_TUMOR_PANEL_OF_NORMAL|SENTIEON_DRIVER_TNSEQ|SENTIEON_CNVSCOPE' {
        container        = params.sentieon_local_container
        containerOptions = {
            def licMount = ""
            def licEnv   = ""
            if (params.sentieon_license) {
                licMount = "--bind ${params.sentieon_license}:${params.sentieon_license}"
                licEnv   = "--env SENTIEON_LICENSE_SERVER=${params.sentieon_license}"
            } else {
                licEnv   = "--env SENTIEON_LICENSE_SERVER=\${SENTIEON_LICENSE:-}"
            }
            "--env LOCAL=true " +
            "${licEnv} " +
            "--env SENTIEON_BIN=/opt/sentieon_local/bin " +
            "--bind ${params.sentieon_install_dir}:/opt/sentieon_local:ro " +
            "${licMount}"
        }
    }

    // ── All processes use the 'broad' queue (only queue available on this cluster) ──
}
